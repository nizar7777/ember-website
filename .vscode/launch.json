{
  // Press F5 (or Run and Debug -> "Open Ember site") and VS Code starts the
  // local server first, then opens Chrome on it.
  //
  // The port here MUST match the one in .vscode/tasks.json. It previously
  // said 8080 while serve.ps1 listens on 5500, and nothing started the
  // server at all — which is why running from VS Code showed nothing.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Ember site",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5500/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Serve Ember site"
    },
    {
      "name": "Open order entry (internal)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5500/order-entry.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Serve Ember site"
    }
  ]
}
